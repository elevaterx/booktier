{
  // Deploy settings live in the repo so a build does not depend on dashboard state.
  // booktier is a static site: no Worker script, no build step — the generated files are committed.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "booktier",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "."
  },
  // Keep the free *.workers.dev URL on. It is the address to test against before DNS points at
  // the custom domain, and a redeploy re-applies whatever this file says — so setting it here
  // stops a later build from quietly turning it off.
  "workers_dev": true,
  "preview_urls": true,
  // Custom domains declared here rather than clicked into the dashboard: `wrangler deploy`
  // creates them, and the config is version-controlled instead of living in someone's UI state.
  // Any pre-existing DNS record for these hostnames must be deleted first, or creation fails.
  "routes": [
    { "pattern": "booktier.org", "custom_domain": true },
    { "pattern": "www.booktier.org", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
