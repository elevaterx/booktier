{
  "name": "booktier",
  "version": "0.1.0",
  "description": "Tier lists for books, where every cover is a link",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "serve": "node tools/serve.mjs",
    "build": "node tools/build-css.mjs && node tools/build-site.mjs",
    "build:css": "node tools/build-css.mjs",
    "build:site": "node tools/build-site.mjs",
    "check": "node tools/build-css.mjs --check && node tools/build-site.mjs --check",
    "smoke": "npm run check && node tools/smoke.mjs"
  },
  "devDependencies": {
    "playwright": "1.50.0"
  }
}
